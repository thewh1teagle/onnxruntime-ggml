diff --git a/src/ggml-metal/kernels/conv.metal b/src/ggml-metal/kernels/conv.metal
index 5685b5c..624781d 100644
--- a/src/ggml-metal/kernels/conv.metal
+++ b/src/ggml-metal/kernels/conv.metal
@@ -64,6 +64,32 @@ kernel void kernel_im2col(
 template [[host_name("kernel_im2col_f32")]] kernel im2col_t kernel_im2col<float>;
 template [[host_name("kernel_im2col_f16")]] kernel im2col_t kernel_im2col<half>;
 
+// Tile contiguous output columns instead of launching one tiny group per
+// input channel and output position. Works for any 1-D kernel/stride/dilation.
+template <typename T>
+kernel void kernel_im2col_1d(
+        constant ggml_metal_kargs_im2col & args,
+        device const float * x,
+        device char * dst,
+        uint3 tgpig [[threadgroup_position_in_grid]],
+        uint3 tgpg [[threadgroups_per_grid]],
+        uint3 tpitg [[thread_position_in_threadgroup]],
+        uint3 ntg [[threads_per_threadgroup]]) {
+    const uint col = tgpig.x*ntg.x + tpitg.x;
+    if (col >= uint(args.CHW)) {
+        return;
+    }
+    const uint c = col / args.KW;
+    const uint k = col % args.KW;
+    const int64_t iw = int64_t(tgpig.y)*args.s0 + int64_t(k)*args.d0 - args.p0;
+    const uint64_t out = (uint64_t(tgpig.z)*tgpg.y + tgpig.y)*args.CHW + col;
+    ((device T *) dst)[out] = iw >= 0 && iw < args.IW
+        ? T(x[tgpig.z*args.ofs0 + c*args.ofs1 + iw]) : T(0);
+}
+
+template [[host_name("kernel_im2col_1d_f32")]] kernel im2col_t kernel_im2col_1d<float>;
+template [[host_name("kernel_im2col_1d_f16")]] kernel im2col_t kernel_im2col_1d<half>;
+
 // TODO: optimize
 typedef void (im2col_ext_t)(
         constant ggml_metal_kargs_im2col & args,
